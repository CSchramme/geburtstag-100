# PIN fuer den Zugang zur Verwaltung (/admin)
ADMIN_PIN=2012

# Zufaelliger, geheimer String zum Signieren des Admin-Sessioncookies
# (z.B. mit `openssl rand -hex 32` erzeugen)
SESSION_SECRET=bitte-aendern-zufaelliger-string

# Oeffentliche Basis-URL der Seite (ohne abschliessenden Slash), wird u.a.
# fuer den Spotify-Redirect benoetigt, z.B. https://50s.it-srm.de
NEXT_PUBLIC_BASE_URL=https://50s.it-srm.de

# Spotify Developer App (https://developer.spotify.com/dashboard)
# Redirect-URI dort exakt eintragen: <NEXT_PUBLIC_BASE_URL>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
